#!/bin/bash
# Commit message hook for Synapse DB
# Validates commit messages follow conventional commits format

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Color codes
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Allow merge commits
if echo "$commit_msg" | grep -qE "^Merge branch"; then
    exit 0
fi

# Allow revert commits
if echo "$commit_msg" | grep -qE "^Revert"; then
    exit 0
fi

# Check for conventional commit format
# Format: type(optional scope): description
# Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore
if ! echo "$commit_msg" | grep -qE "^(feat|fix|docs|style|refactor|perf|test|build|ci|chore)(\(.+\))?: .{3,}"; then
    echo -e "${RED}✗ Invalid commit message format${NC}" >&2
    echo "" >&2
    echo "Commit messages must follow the Conventional Commits format:" >&2
    echo "" >&2
    echo -e "${YELLOW}  <type>[optional scope]: <description>${NC}" >&2
    echo "" >&2
    echo "Types:" >&2
    echo "  feat:     New feature" >&2
    echo "  fix:      Bug fix" >&2
    echo "  docs:     Documentation changes" >&2
    echo "  style:    Code style (formatting, no logic change)" >&2
    echo "  refactor: Code refactoring" >&2
    echo "  perf:     Performance improvement" >&2
    echo "  test:     Tests" >&2
    echo "  build:    Build system" >&2
    echo "  ci:       CI/CD changes" >&2
    echo "  chore:    Maintenance" >&2
    echo "" >&2
    echo "Examples:" >&2
    echo "  feat: add query caching" >&2
    echo "  fix: resolve memory leak in storage" >&2
    echo "  docs(readme): update installation instructions" >&2
    echo "" >&2
    echo "To bypass this check (not recommended):" >&2
    echo "  git commit --no-verify" >&2
    echo "" >&2
    exit 1
fi

# Check for minimum description length
description=$(echo "$commit_msg" | head -n1 | sed -E 's/^[^:]+: //')
if [ ${#description} -lt 3 ]; then
    echo -e "${RED}✗ Commit description too short${NC}" >&2
    echo "Description must be at least 3 characters" >&2
    exit 1
fi

# Warn if first line is too long (soft limit)
first_line=$(echo "$commit_msg" | head -n1)
if [ ${#first_line} -gt 72 ]; then
    echo -e "${YELLOW}⚠ Warning: First line is ${#first_line} characters (recommended: ≤72)${NC}" >&2
fi

exit 0
