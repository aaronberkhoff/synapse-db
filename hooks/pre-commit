#!/bin/bash
# Pre-commit hook for Synapse DB
# Automatically formats and lints code before committing

set -e

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}🔍 Running pre-commit checks...${NC}\n"

# Get list of staged Rust files
STAGED_RS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)

if [ -z "$STAGED_RS_FILES" ]; then
    echo -e "${GREEN}✓${NC} No Rust files to check"
    exit 0
fi

echo -e "${YELLOW}📝 Formatting code with rustfmt...${NC}"
# Format all Rust code
cargo fmt --all

# Add formatted files back to staging
echo "$STAGED_RS_FILES" | while IFS= read -r file; do
    if [ -f "$file" ]; then
        git add "$file"
        echo -e "${GREEN}  ✓${NC} Formatted and staged: $file"
    fi
done

echo ""
echo -e "${YELLOW}🔧 Running clippy with auto-fix...${NC}"
# Run clippy with auto-fix for staged files
cargo clippy --fix --allow-staged --allow-dirty --all-targets --all-features -- -D warnings 2>&1 | head -20

# Re-stage any files that clippy fixed
echo "$STAGED_RS_FILES" | while IFS= read -r file; do
    if [ -f "$file" ] && git diff --name-only | grep -q "^$file$"; then
        git add "$file"
        echo -e "${GREEN}  ✓${NC} Fixed and staged: $file"
    fi
done

echo ""
echo -e "${YELLOW}🔍 Final clippy check...${NC}"
# Run clippy again to ensure no warnings remain
if ! cargo clippy --all-targets --all-features -- -D warnings 2>&1 | head -20; then
    echo -e "\n${RED}✗ Clippy found warnings that couldn't be auto-fixed${NC}"
    echo -e "${YELLOW}Please fix the remaining issues manually${NC}"
    exit 1
fi

echo ""
echo -e "${GREEN}✅ All pre-commit checks passed!${NC}\n"
exit 0
