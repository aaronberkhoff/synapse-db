# Auto detect text files and perform LF normalization
* text=auto

# Rust source files
*.rs text eol=lf

# Cargo files
Cargo.toml text eol=lf
Cargo.lock text eol=lf linguist-generated=true

# Shell scripts
*.sh text eol=lf

# GitHub workflows
*.yml text eol=lf
*.yaml text eol=lf

# Documentation
*.md text eol=lf
LICENSE text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
